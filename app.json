{
  "expo": {
    "name": "Smart Ledger",
    "slug": "smart-ledger",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.korkh.smartledger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": ["CAMERA"],
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Smart Ledger to access your camera to scan barcodes and QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c215ee4-51ca-4430-88ed-31dc62a2da30"
      }
    }
  }
}
